<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/truckie_sky"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/trip_stops"
        android:textColor="@color/truckie_navy"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/clearanceSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/truckie_navy"
        android:textSize="13sp" />

    <ListView
        android:id="@+id/stopList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:dividerHeight="1dp" />

    <TextView
        android:id="@+id/emptyStops"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/no_stops_yet"
        android:textColor="@color/truckie_navy"
        android:textSize="16sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/addStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/add_stop" />
</LinearLayout>
