<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/truckie_sky"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/editTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/edit_profile"
            android:textColor="@color/truckie_navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/fieldRego"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_rego"
            android:inputType="textCapCharacters"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldNickname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_nickname"
            android:inputType="textCapWords"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldVehicleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_vehicle_type"
            android:inputType="textCapWords"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldMake"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_make"
            android:inputType="textCapWords"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldModel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_model"
            android:inputType="textCapWords"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_year"
            android:inputType="number"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldHeight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_height_m"
            android:inputType="numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldWidth"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_width_m"
            android:inputType="numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldLength"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_length_m"
            android:inputType="numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldMass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_mass_t"
            android:inputType="numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldTare"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_tare_t"
            android:inputType="numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldGvm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_gvm_t"
            android:inputType="numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldGcm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_gcm_t"
            android:inputType="numberDecimal"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldAxles"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_axles"
            android:inputType="number"
            android:importantForAutofill="no" />

        <EditText
            android:id="@+id/fieldNetwork"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_network_class"
            android:inputType="textCapCharacters"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/saveVehicle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save" />
    </LinearLayout>
</ScrollView>
