<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/truckie_sky"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_stop_title"
            android:textColor="@color/truckie_navy"
            android:textSize="24sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/fieldAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/hint_address"
            android:importantForAutofill="no"
            android:inputType="textPostalAddress" />

        <LinearLayout
            android:id="@+id/cargoSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cargo_at_stop"
                android:textColor="@color/truckie_navy"
                android:textSize="16sp"
                android:textStyle="bold" />

            <RadioGroup
                android:id="@+id/cargoActionGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/actionPickUp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="@string/pick_up" />

                <RadioButton
                    android:id="@+id/actionDropOff"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/drop_off" />
            </RadioGroup>

            <EditText
                android:id="@+id/fieldCargoDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_cargo_description"
                android:importantForAutofill="no"
                android:inputType="textCapSentences" />

            <EditText
                android:id="@+id/fieldCargoHeight"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_height_m"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/fieldCargoWidth"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_width_m"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/fieldCargoLength"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_length_m"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <EditText
                android:id="@+id/fieldCargoMass"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_mass_t"
                android:importantForAutofill="no"
                android:inputType="numberDecimal" />

            <Button
                android:id="@+id/addAnotherCargo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/add_another_cargo" />

            <TextView
                android:id="@+id/pendingCargoList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/truckie_navy"
                android:textSize="13sp" />
        </LinearLayout>

        <Button
            android:id="@+id/saveStop"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/save_stop" />
    </LinearLayout>
</ScrollView>
