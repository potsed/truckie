<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Cars App Library declares minSdk 23; phone app stays at 16 with Auto gated in code. -->
    <uses-sdk tools:overrideLibrary="androidx.car.app,androidx.car.app.projected" />

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:name=".TruckieApp"
        android:allowBackup="true"
        android:icon="@drawable/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Truckie1">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".profiles.VehicleListActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <activity
            android:name=".profiles.VehicleEditActivity"
            android:exported="false"
            android:parentActivityName=".profiles.VehicleListActivity" />

        <!-- Android Auto service: declared for Phase 1+; gated in code to API 23+ -->
        <service
            android:name=".auto.TruckieCarAppService"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="androidx.car.app.CarAppService" />
                <category android:name="androidx.car.app.category.NAVIGATION" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />
    </application>
</manifest>
