# Copy to compose/.env on the VM (or secrets/.env locally). NEVER commit real .env.
# Optional later: load the same keys from OCI Vault → instance env via agent.

# Public hostname (DNS A → Terraform output public_ip)
GRAPHHOPPER_DOMAIN=gh.example.com

# Let’s Encrypt registration
LETSENCRYPT_EMAIL=you@example.com

# GraphHopper release pin (Dockerfile ARG)
GH_VERSION=11.1

# Heap — leave headroom for OS on 12 GB Ampere (SEQ graph)
JAVA_OPTS=-Xmx8g -Xms2g

# Compose project name
COMPOSE_PROJECT_NAME=oci-graphhopper

