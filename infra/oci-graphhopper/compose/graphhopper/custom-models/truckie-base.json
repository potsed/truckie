{
  "distance_influence": 90,
  "priority": [
    {
      "if": "hgv == NO",
      "multiply_by": "0"
    },
    {
      "if": "!car_access && road_access != PRIVATE && hgv != DELIVERY && hgv != DESTINATION",
      "multiply_by": "0"
    },
    {
      "if": "road_access == PRIVATE || hgv == DELIVERY || hgv == DESTINATION",
      "multiply_by": "0.1"
    },
    {
      "if": "road_class == MOTORWAY",
      "multiply_by": "1.0"
    },
    {
      "if": "road_class == TRUNK || road_class == PRIMARY",
      "multiply_by": "0.95"
    },
    {
      "if": "road_class == RESIDENTIAL",
      "multiply_by": "0.1"
    },
    {
      "if": "road_class == LIVING_STREET || road_class == PEDESTRIAN || road_class == FOOTWAY",
      "multiply_by": "0"
    }
  ],
  "speed": [
    {
      "if": "true",
      "limit_to": "car_average_speed * 0.9"
    },
    {
      "if": "true",
      "limit_to": "95"
    }
  ]
}
