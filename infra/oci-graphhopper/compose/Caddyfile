{
	email {$LETSENCRYPT_EMAIL}
}

{$GRAPHHOPPER_DOMAIN} {
	encode gzip

	# Truckie PathRouter posts JSON to /route
	handle /route* {
		reverse_proxy graphhopper:8989
	}

	# Health for uptime checks (optional monitoring)
	handle /health* {
		reverse_proxy graphhopper:8989
	}

	# Info / profiles — useful for operators; not required by the app
	handle /info* {
		reverse_proxy graphhopper:8989
	}

	# Deny everything else (admin UI, arbitrary paths)
	handle {
		respond "Not found" 404
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	log {
		output stdout
		format console
	}
}
