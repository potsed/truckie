# Copy to compose/.env on the VM (or secrets/.env locally). NEVER commit real .env.
# Optional later: load the same keys from OCI Vault → instance env via agent.

# Public hostname (DNS A → Terraform output public_ip)
VALHALLA_DOMAIN=vh.example.com

# Let’s Encrypt registration
LETSENCRYPT_EMAIL=you@example.com

# Official Valhalla scripted image pin (multi-arch; Ampere = arm64)
VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:3.9.3

# Tile build behaviour (import-qld-seq.sh sets FORCE_REBUILD=True during rebuild)
USE_TILES_IGNORE_PBF=True
FORCE_REBUILD=False
SERVER_THREADS=2

# Compose project name
COMPOSE_PROJECT_NAME=oci-valhalla
