# Copy to secrets.properties (gitignored). Never commit real keys.
# Assemble reads these into BuildConfig — see docs/valhalla-live.md.

# Interim: hosted Valhalla (Simple Routing OSS-compatible /route).
# VALHALLA_API_KEY=your_simplerouting_key_here
# Optional override (defaults to https://api.simplerouting.io/valhalla when key is set):
# VALHALLA_BASE_URL=https://api.simplerouting.io/valhalla

# Self-hosted (OCI Free Tier / local compose) — set base URL, clear API key.
# See docs/oci-valhalla-runbook.md and infra/oci-valhalla/.
# Also accepted in local.properties (gitignored).
# VALHALLA_BASE_URL=https://vh.example.com
# VALHALLA_API_KEY=

